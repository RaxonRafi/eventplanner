# ─────────────────────────────────────────────────────────────
# Eventers — environment variables
# Copy to .env.local for development. In production, set these in
# Vercel → Project → Settings → Environment Variables (Production).
# ─────────────────────────────────────────────────────────────

# Database (Neon Postgres). DATABASE_URL = pooled, DIRECT_URL = direct (used by migrations)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth — long random string, e.g. `openssl rand -base64 48`. Must differ from dev.
NEXTAUTH_SECRET=""

# SSLCommerz payment gateway
#   SSL_MODE=sandbox → https://sandbox.sslcommerz.com (test cards, no real money)
#   SSL_MODE=live    → https://securepay.sslcommerz.com (needs LIVE store credentials)
# Success/fail/cancel callback URLs are derived from the request origin automatically,
# so no callback URL variables are needed.
SSL_MODE="sandbox"
SSL_STORE_ID=""
SSL_STORE_PASS=""
# Optional: server-to-server IPN endpoint (ignored if it points to localhost)
SSL_IPN_URL=""

# Cloudinary — event banner uploads (Vercel's filesystem is read-only)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email receipts (Gmail: smtp.gmail.com, port 465, use an App Password — not your account password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Seed script (npm run db:seed) — super admin + demo accounts
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
DEMO_PASSWORD=""

# Optional: only if the API is served from a different origin
# NEXT_PUBLIC_API_URL=""
